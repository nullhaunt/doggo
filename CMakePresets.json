{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{DEVKITPRO}/cmake/Switch.cmake"
      }
    },
    {
      "name": "doggo-debug",
      "displayName": "DOGGO Debug",
      "description": "Configure the complete Nintendo Switch workspace in Debug mode.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "doggo-release",
      "displayName": "DOGGO Release",
      "description": "Configure the complete Nintendo Switch workspace in Release mode.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "host-debug",
      "displayName": "DOGGO Host Tests (Debug)",
      "description": "Configure platform-independent host tests in Debug mode.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "DOGGO_BUILD_GAME": "OFF",
        "DOGGO_BUILD_HOST_TESTS": "ON"
      }
    },
    {
      "name": "host-release",
      "displayName": "DOGGO Host Tests (Release)",
      "description": "Configure platform-independent host tests in Release mode.",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "engine-debug",
      "displayName": "Engine only (Debug)",
      "configurePreset": "doggo-debug",
      "targets": "doggo_platform_nx"
    },
    {
      "name": "engine-release",
      "displayName": "Engine only (Release)",
      "configurePreset": "doggo-release",
      "targets": "doggo_platform_nx"
    },
    {
      "name": "game-debug",
      "displayName": "Game + dependencies (Debug)",
      "configurePreset": "doggo-debug",
      "targets": "doggo_game_nro"
    },
    {
      "name": "game-release",
      "displayName": "Game + dependencies (Release)",
      "configurePreset": "doggo-release",
      "targets": "doggo_game_nro"
    },
    {
      "name": "all-debug",
      "displayName": "Everything (Debug)",
      "configurePreset": "doggo-debug",
      "targets": "doggo_all"
    },
    {
      "name": "all-release",
      "displayName": "Everything (Release)",
      "configurePreset": "doggo-release",
      "targets": "doggo_all"
    },
    {
      "name": "host-debug",
      "displayName": "Host tests (Debug)",
      "configurePreset": "host-debug",
      "targets": "doggo-host-tests"
    },
    {
      "name": "host-release",
      "displayName": "Host tests (Release)",
      "configurePreset": "host-release",
      "targets": "doggo-host-tests"
    }
  ],
  "testPresets": [
    {
      "name": "host-debug",
      "configurePreset": "host-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-release",
      "configurePreset": "host-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
